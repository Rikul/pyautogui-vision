# PyAutoGUI VLM & Environment Configuration
# Copy this file to .env (or export these variables in your shell)

# OpenAI-compatible VLM endpoint URL
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
#   OpenRouter: https://openrouter.ai/api/v1
PYAUTOGUI_VLM_BASE_URL=http://localhost:11434/v1

# API Key for the VLM provider (falls back to OPENAI_API_KEY if unset; use "ollama" or "local" for local servers)
PYAUTOGUI_VLM_API_KEY=ollama
# OPENAI_API_KEY=sk-...

# Vision-Language Model name
# Examples: gpt-4o, qwen2.5-vl, llama3.2-vision, claude-3-7-sonnet
PYAUTOGUI_VLM_MODEL=qwen2.5-vl

# Request timeout in seconds (default: 60.0)
PYAUTOGUI_VLM_TIMEOUT=60.0

# Coordinate scale returned by the VLM ("pixel" or "normalized_1000")
PYAUTOGUI_VLM_COORD_SCALE=pixel

# Optional WSL override:
# Set to "1" / "true" to force WSL Windows host bridge, or "0" / "false" to force native X11 inside WSLg
# PYAUTOGUI_WSL=1
